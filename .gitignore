# Ignore local Python development artifacts only.
# Preserve research evidence, logs, datasets, and databases.

# Python bytecode
__pycache__/
*.py[cod]
*$py.class

# Local virtual environments
.venv/
venv/

# Generated analysis and test caches
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Local environment secrets (example templates may be committed after review)
.env
.env.*
!.env.example
!.env.sample
!.env.template
